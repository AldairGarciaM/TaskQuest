generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
  EPIC
}

enum TaskStatus {
  PENDING
  COMPLETED
}

/// Org tasks go through a manager's review before they're completed and pay XP.
enum OrgTaskStatus {
  PENDING
  IN_REVIEW
  COMPLETED
}

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
}

enum DailyMissionType {
  COMPLETE_TASKS
  COMPLETE_HARD
  COMPLETE_ON_TIME
  COMPLETE_VARIETY
}

model User {
  id             String   @id @default(cuid())
  firstName      String
  lastName       String
  /// Lowercase, 3–20 chars of a-z, 0-9, "_" or ".". Can be used to sign in.
  username       String   @unique
  email          String   @unique
  passwordHash   String
  /// Bumped when the password changes; sessions signed with an older value stop working.
  sessionVersion Int      @default(0)
  xp             Int      @default(0)
  level          Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  passwordResetTokens PasswordResetToken[]
  tasks               Task[]
  dailyMissions       DailyMission[]
  achievements        UserAchievement[]
  memberships         Membership[]
  invitations         Invitation[]

  assignedOrgTasks  OrgTask[]      @relation("OrgTaskAssignee")
  createdOrgTasks   OrgTask[]      @relation("OrgTaskCreator")
  completedOrgTasks OrgTask[]      @relation("OrgTaskCompleter")
  reviewedOrgTasks  OrgTask[]      @relation("OrgTaskReviewer")
  notifications     Notification[]
}

model Task {
  id          String     @id @default(cuid())
  title       String
  description String?
  difficulty  Difficulty @default(EASY)
  xpReward    Int
  status      TaskStatus @default(PENDING)
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

/// Three missions per user per day, picked from a catalog in src/lib/gamification/daily.ts.
/// Progress is computed from the tasks completed that day; only the reward state is stored.
model DailyMission {
  id         String           @id @default(cuid())
  /// Calendar day "YYYY-MM-DD" in APP_TIME_ZONE.
  day        String
  type       DailyMissionType
  target     Int
  xpReward   Int
  rewardedAt DateTime?
  createdAt  DateTime         @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day, type])
}

/// Achievement definitions live in code (src/lib/gamification/achievements.ts); this stores who unlocked what.
model UserAchievement {
  id         String   @id @default(cuid())
  key        String
  unlockedAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  /// URL id: slugified name plus a random suffix.
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members       Membership[]
  invitations   Invitation[]
  tasks         OrgTask[]
  notifications Notification[]
}

/// Exactly one OWNER per organization (the creator).
model Membership {
  id        String   @id @default(cuid())
  role      OrgRole  @default(MEMBER)
  createdAt DateTime @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

/// Only the SHA-256 of the link token is stored. Revoking deletes the row.
model Invitation {
  id         String    @id @default(cuid())
  /// Lowercase. Only an account with this email can accept.
  email      String
  role       OrgRole   @default(MEMBER)
  tokenHash  String    @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedById    String?
  invitedBy      User?        @relation(fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([organizationId, email])
}

/// A task on an organization board. No assignee = any member can take it.
/// The assignee submits it for review; a manager approves it (pays XP to the assignee's personal level)
/// or sends it back with a note. A manager reopening a completed task takes that XP back.
model OrgTask {
  id           String        @id @default(cuid())
  title        String
  description  String?
  difficulty   Difficulty    @default(EASY)
  xpReward     Int
  status       OrgTaskStatus @default(PENDING)
  dueDate      DateTime?
  /// True when the assignee took it from the open pool (they may give it back).
  selfAssigned Boolean       @default(false)
  /// When the assignee sent it for review (null while pending).
  submittedAt  DateTime?
  /// Why a manager sent it back; shown to the assignee until they submit again.
  reviewNote   String?
  completedAt  DateTime?
  /// XP actually paid on completion, so reopening reverses exactly that.
  awardedXp    Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assigneeId     String?
  assignee       User?        @relation("OrgTaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdById    String?
  createdBy      User?        @relation("OrgTaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  completedById  String?
  completedBy    User?        @relation("OrgTaskCompleter", fields: [completedById], references: [id], onDelete: SetNull)
  reviewedById   String?
  reviewedBy     User?        @relation("OrgTaskReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([assigneeId])
}

enum NotificationType {
  ORG_TASK_APPROVED
  ORG_TASK_CHANGES_REQUESTED
}

/// Something that happened to the user's work while they weren't looking (e.g. a manager reviewed it).
/// Task details are copied so the message still reads right after the task is edited or deleted.
model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  taskTitle String
  /// XP paid to the recipient (approvals only).
  xp        Int              @default(0)
  /// The recipient's new level when the approval made them level up.
  level     Int?
  /// The reviewer's comments when they asked for changes.
  note      String?
  /// First name of whoever reviewed it, as it was at the time.
  actorName String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// Fixed-window counters for rate limiting (login attempts, sign-ups, invitations).
/// `key` names the action and who does it, e.g. "login:account:ada" or "invite:<userId>".
model RateLimit {
  key     String   @id
  count   Int
  /// When the current window ends; the next hit after it starts a new window.
  resetAt DateTime @db.Timestamptz(3)

  @@index([resetAt])
}

/// One-time link to choose a new password. Only the SHA-256 of the token is stored.
model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
