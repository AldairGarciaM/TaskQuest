generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
  EPIC
}

enum TaskStatus {
  PENDING
  COMPLETED
}

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
}

enum DailyMissionType {
  COMPLETE_TASKS
  COMPLETE_HARD
  COMPLETE_ON_TIME
  COMPLETE_VARIETY
}

model User {
  id           String   @id @default(cuid())
  firstName    String
  lastName     String
  /// Lowercase, 3–20 chars of a-z, 0-9, "_" or ".". Can be used to sign in.
  username     String   @unique
  email        String   @unique
  passwordHash String
  xp           Int      @default(0)
  level        Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tasks         Task[]
  dailyMissions DailyMission[]
  achievements  UserAchievement[]
  memberships   Membership[]
  invitations   Invitation[]
}

model Task {
  id          String     @id @default(cuid())
  title       String
  description String?
  difficulty  Difficulty @default(EASY)
  xpReward    Int
  status      TaskStatus @default(PENDING)
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

/// Three missions per user per day, picked from a catalog in src/lib/gamification/daily.ts.
/// Progress is computed from the tasks completed that day; only the reward state is stored.
model DailyMission {
  id         String           @id @default(cuid())
  /// Calendar day "YYYY-MM-DD" in APP_TIME_ZONE.
  day        String
  type       DailyMissionType
  target     Int
  xpReward   Int
  rewardedAt DateTime?
  createdAt  DateTime         @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day, type])
}

/// Achievement definitions live in code (src/lib/gamification/achievements.ts); this stores who unlocked what.
model UserAchievement {
  id         String   @id @default(cuid())
  key        String
  unlockedAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  /// URL id: slugified name plus a random suffix.
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members     Membership[]
  invitations Invitation[]
}

/// Exactly one OWNER per organization (the creator).
model Membership {
  id        String   @id @default(cuid())
  role      OrgRole  @default(MEMBER)
  createdAt DateTime @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

/// Only the SHA-256 of the link token is stored. Revoking deletes the row.
model Invitation {
  id         String    @id @default(cuid())
  /// Lowercase. Only an account with this email can accept.
  email      String
  role       OrgRole   @default(MEMBER)
  tokenHash  String    @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedById    String?
  invitedBy      User?        @relation(fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([organizationId, email])
}
