# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/taskquest?schema=public"

# NextAuth v4
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""

# Email (optional). Without SMTP_HOST, invitation links are logged to the console
# and shown in the UI so they can be copied by hand.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="TaskQuest <no-reply@taskquest.local>"
